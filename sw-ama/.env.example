# Postgres connection string, e.g. postgresql://user:password@host:5432/shipwrights_ama
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shipwrights_ama"

# Shared team passcode required to create a new admin account after the
# first one exists (the first account bootstraps with no passcode needed).
ADMIN_PASSCODE="change-me"

# Long random string used to sign admin session cookies. Generate with:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET="change-me-too"
